# Supabase project used ONLY for the karim.dev portfolio admin area
# (Auth + Storage). This must always be a project dedicated solely to the
# portfolio — never the delivery-system's production Supabase project.
#
# Both values below are the publishable client config, safe to ship in the
# browser bundle by Supabase's own design — the anon/publishable key is not
# a secret; it's paired with Row-Level Security / Storage policies to do
# the actual access control. Never put a service-role/secret key here.
VITE_SUPABASE_URL=https://your-portfolio-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
